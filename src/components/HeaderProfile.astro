---
import profile from '../data/profile.json';
const { name, subtitle, bio, contact } = profile;
---
<div>
	<!-- Hero -->
	<header id="hero">
		<h1>{name}</h1>
		<p class="subtitle">{subtitle}</p>
		<p class="bio">{bio}</p>
		<div class="contact">
			{contact.map((link) => {
				const external = !link.href.startsWith('mailto:');
				return (
					<p>{link.label}: <a href={link.href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>{link.text}</a></p>
				);
			})}
		</div>
	</header>
</div>

<style>
	/* Hero */
	#hero {
		margin-bottom: 60px;
	}

	h1 {
		font-size: 64px;
		margin: 0 0 4px;
	}

	.subtitle {
		margin: 0 0 8px;
		font-size: 16px;
		opacity: 0.7;
	}

	.bio {
		margin: 0 0 16px;
		font-size: 15px;
	}

	.contact {
		justify-content: flex-start;
	}

	.contact p {
		margin: 8px;
		font-size: 14px;
	}
</style>
