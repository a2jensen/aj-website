---
import { getCollection } from 'astro:content';

const notes = (await getCollection('notes'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<div >
<section id="notes">
	<h2>reads</h2>
	<div class="notes-list">
		{notes.map((note) => (
			<a href={`/notes/${note.id}`} class="note-link">{note.data.title}</a>
		))}
	</div>
</section>
</div>

<style>
	#notes {
		margin-bottom: 60px;
	}

	.notes-list {
		display: flex;
		flex-direction: column;
		width: 60%;
	}

	.note-link {
		color: inherit;
		text-decoration: none;
		font-size: 15px;
		font-weight: 600;
		padding: 8px 0;
	}

	@media screen and (max-width: 600px) {
		.notes-list {
			width: 90%;
		}
	}
</style>
