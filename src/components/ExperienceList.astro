---
import Paged from './Paged.astro';
import profile from '../data/profile.json';
import { chunk } from '../scripts/chunk';

const pages = chunk(profile.experience, 3);
---
<!-- Experience -->
<section id="experience">
    <h2>experience</h2>
    <Paged>
        {pages.map((page, i) => (
            <div data-page data-active={i === 0 ? '' : undefined}>
                {page.map((exp) => (
                    <div class="experience-item">
                        <div class="experience-header">
                            <strong>{exp.title}</strong>
                            <span class="dates">{exp.dates}</span>
                        </div>
                        <span class="company">{exp.company}</span>
                        <p>{exp.description}</p>
                    </div>
                ))}
            </div>
        ))}
    </Paged>
</section>

<style>
    /* Experience */
	#experience {
		margin-bottom: 60px;
	}

	.experience-item {
		margin-bottom: 20px;
	}

	.experience-header {
		text-align: left;
		gap: 8px;
	}

	.dates {
		font-size: 13px;
		opacity: 0.6;
	}

	.company {
		font-size: 14px;
		opacity: 0.7;
	}

	.experience-item p {
		margin: 4px 0 0;
		font-size: 14px;
		line-height: 1.5;
		white-space: pre-line;
	}

	@media screen and (min-width: 601px) {
		#experience {
			display: flex;
			flex-direction: column;
			margin-bottom: 0;
		}
	}
</style>
